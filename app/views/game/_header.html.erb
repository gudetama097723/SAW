<%
  header_weapons = @player.equipped_weapons
  hp_percent = [[@player.hp.to_i * 100 / [@player.effective_max_hp, 1].max, 0].max, 100].min
  hp_bar_class = hp_percent <= 20 ? "bg-danger" : (hp_percent <= 50 ? "bg-warning" : "bg-success")
  hp_meter_class = hp_percent <= 20 ? "game-status-meter-danger" : (hp_percent <= 50 ? "game-status-meter-warning" : nil)
  exp_percent = [[@player.exp.to_i * 100 / [@player.exp_to_next_level, 1].max, 0].max, 100].min
%>

<div class="game-header-panel">
  <div class="game-header-topline">
    <div class="game-header-primary">
      <div class="game-floor-badge">第1層</div>
      <div class="game-location-block">
        <div class="game-header-label">フィールド名</div>
        <div class="game-header-value"><%= @player.field_route ? "#{@player.field_route.name}（移動中）" : (@player.location&.name || "不明") %></div>
        <% if @current_field_area %>
          <div class="small text-secondary">全体踏破度 <%= @player.field_route_mapping_progress %>%</div>
        <% end %>
      </div>

      <% if @player.field_route.present? %>
        <div class="game-location-block">
          <div class="game-header-label">現在地</div>
          <div class="game-header-value"><%= @current_field_area&.name || "不明" %></div>
          <div class="small text-secondary">
            エリア踏破度 <%= @current_field_area_progress&.mapping_progress.to_i %>%
          </div>
        </div>
      <% end %>

      <% if @player.home_base %>
        <div class="game-location-block">
          <div class="game-header-label">本拠点</div>
          <div class="game-header-value"><%= @player.home_base.location.name %></div>
        </div>
      <% end %>
    </div>

    <div class="game-header-secondary">
      <div class="text-end game-environment-summary">
        <div class="fw-semibold"><%= @player.formatted_datetime %></div>
        <% if @environment_location.present? %>
          <div class="d-flex flex-wrap justify-content-end gap-2 small mt-1">
            <span class="game-status-chip">時間帯：<%= time_period_label(@player) %></span>
            <span class="game-status-chip">季節：<%= @player.current_season_label %></span>
            <span class="game-status-chip">天気：<%= @environment_location.weather_label %></span>
            <span class="game-status-chip">環境：<%= @environment_location.environment_label %></span>
          </div>
        <% end %>
      </div>

      <% if current_user %>
        <div class="game-session-actions">
          <span class="text-secondary small">ログイン中: <%= current_user.username %></span>
          <%= button_to "ログアウト", logout_path, method: :delete, class: "btn btn-outline-light btn-sm" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="game-header-status">
    <div class="game-status-identity">
      <strong><%= @player.name %></strong>
      <span class="badge bg-info text-dark">Lv <%= @player.level.to_i %></span>
      <% @player.condition_labels.each do |label| %>
        <span class="badge bg-warning text-dark"><%= label %></span>
      <% end %>
    </div>

    <div class="<%= ["game-status-meter", hp_meter_class].compact.join(" ") %>">
      <div class="game-status-meter-head">
        <span>HP</span>
        <strong><%= @player.hp %>/<%= @player.effective_max_hp %></strong>
      </div>
      <div class="progress game-header-progress">
        <div class="progress-bar <%= hp_bar_class %>" style="width: <%= hp_percent %>%"></div>
      </div>
    </div>

    <div class="game-status-meter">
      <div class="game-status-meter-head">
        <span>EXP</span>
        <strong><%= @player.exp.to_i %>/<%= @player.exp_to_next_level %></strong>
      </div>
      <div class="progress game-header-progress">
        <div class="progress-bar bg-info" style="width: <%= exp_percent %>%"></div>
      </div>
    </div>

    <div class="game-status-weapons">
      <% if header_weapons.any? %>
        <% header_weapons.each do |weapon| %>
          <div class="game-status-weapon">
            <span><%= weapon.display_name %></span>
            <div class="game-status-weapon-values">
              <strong>ATK <%= formatted_attack_power(weapon.effective_attack_power) %></strong>
              <strong class="game-status-weapon-durability <%= weapon_durability_state_class(weapon) %>" style="--durability-percent: <%= weapon.durability_percent %>%">
                DUR <%= weapon.durability %>/<%= weapon.effective_max_durability %>
              </strong>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="game-status-weapon">
          <span>武器なし</span>
          <div class="game-status-weapon-values">
            <strong>素手</strong>
          </div>
        </div>
      <% end %>
    </div>

    <div class="game-status-col">
      <span>所持刻銭</span>
      <strong><%= @player.col %></strong>
    </div>
  </div>
</div>
