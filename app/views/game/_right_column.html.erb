        <div class="<%= class_names("col-md-4", "ms-md-auto": @battle.blank? && @rest.blank? && selected_panel.blank?) %>">
          <% if @battle.present? %>
            <%= render "game/enemy_panel" %>
          <% elsif @rest.present? %>
            <%= render "game/rest_panel" %>
          <% else %>
            <%= render "game/world_panel", selected_panel: selected_panel, equipped_weapon: equipped_weapon %>
          <% end %>
        </div>
