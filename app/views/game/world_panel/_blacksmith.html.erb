<% blacksmith_menu = params[:blacksmith_menu].presence %>
<% player_blacksmith_skill = BlacksmithService.blacksmith_skill_for(@player) %>
<% smith_mode = player_blacksmith_skill && params[:smith_mode] == "player" ? "player" : "npc" %>
<% npc_blacksmith = BlacksmithService.current_for(@player) %>
<% context = BlacksmithService.context_for(@player, mode: smith_mode, blacksmith: npc_blacksmith) %>
<div class="card-header">鍛冶屋</div>
<div class="card-body">
  <div class="border rounded p-2 mb-3">
    <p class="mb-1"><strong>鍛冶師: <%= context&.name || "選択できません" %></strong></p>
    <p class="mb-2"><%= BlacksmithService.skill_label(context) %></p>
    <% if player_blacksmith_skill %>
      <p class="small text-muted mb-1">鍛冶を行う者を選択</p>
      <div class="d-flex gap-2">
        <% if npc_blacksmith %>
          <%= link_to npc_blacksmith.name, game_path(panel: "blacksmith", blacksmith_menu: blacksmith_menu, smith_mode: "npc"), class: "btn btn-sm #{smith_mode == 'npc' ? 'btn-warning' : 'btn-outline-warning'} flex-fill" %>
        <% end %>
        <%= link_to "自分", game_path(panel: "blacksmith", blacksmith_menu: blacksmith_menu, smith_mode: "player"), class: "btn btn-sm #{smith_mode == 'player' ? 'btn-warning' : 'btn-outline-warning'} flex-fill" %>
      </div>
    <% end %>
  </div>

  <% if blacksmith_menu == "produce" %>
    <h6>武器生産</h6>
    <% if params[:weapon_name].present? %>
      <p class="mb-1">現所持数: <%= owned_weapon_count(@player, params[:weapon_name]) %>本</p>
    <% end %>
    <p class="small text-muted">武器種と3枠の素材から性能を生成します。完成性能と武器名は鍛造まで確定しません。</p>
    <% if context %>
      <%= form_with url: produce_weapon_path, method: :post, local: true do |form| %>
        <%= form.hidden_field :smith_mode, value: smith_mode %>
        <div class="mb-2">
          <%= form.label :weapon_type, "武器種", class: "form-label" %>
          <%= form.select :weapon_type, options_for_select(WeaponCraftTypeCatalog.all.map { |entry| [entry.weapon_type, entry.weapon_type] }), {}, class: "form-select" %>
        </div>
        <% [["ore_material", "鉱石素材", "ore"], ["monster_material", "モンスター素材", "monster_material"], ["support_material", "補助素材", "support_material"]].each do |field, label, category| %>
          <div class="mb-2">
            <%= form.label field, label, class: "form-label" %>
            <%= form.select field, options_for_select(BlacksmithMaterialCatalog.for_category(category).map { |material| ["#{material.name}（加工Lv#{material.processing_level}／所持#{@player.items.where(name: material.name).sum(:quantity)}）", material.name] }), {}, class: "form-select" %>
          </div>
        <% end %>
        <p class="small mb-2"><%= context.player? ? "工賃：0コル" : "工賃：鉱石ランクと担当鍛冶師により決定" %></p>
        <%= form.submit "鍛造する", class: "btn btn-outline-warning w-100" %>
      <% end %>
    <% else %>
      <p class="text-warning mb-0">現在利用できる鍛冶師がいません。</p>
    <% end %>

  <% elsif blacksmith_menu == "repair" %>
    <% damaged_weapons = @player.weapons.select { |weapon| weapon.durability.to_i < weapon.effective_max_durability } %>
    <% damaged_armors = @player.armors.select { |armor| armor.repair_cost.positive? } %>
    <% bulk_weapons = smith_mode == "npc" && context ? damaged_weapons.select { |weapon| context.proficiency >= weapon.maintenance_level.to_i } : [] %>
    <% bulk_equipment_count = bulk_weapons.size + damaged_armors.size %>
    <% bulk_repair_cost = bulk_weapons.sum { |weapon| (weapon.repair_cost * context.fee_multiplier(:maintenance)).round } + damaged_armors.sum(&:repair_cost) %>
    <% if smith_mode == "npc" && bulk_equipment_count.positive? %>
      <% if params[:confirm_repair_all] == "1" %>
        <div class="border border-warning rounded p-2 mb-3">
          <h6>すべて整備しますか？</h6>
          <p class="mb-1">対象: <%= bulk_equipment_count %>点</p>
          <p class="mb-2">費用: <%= bulk_repair_cost %>コル</p>
          <div class="d-flex gap-2">
            <%= button_to "はい", blacksmith_path(repair_all: "1", confirm_repair: "1", smith_mode: smith_mode), method: :post, form: { class: "flex-fill" }, class: "btn btn-warning w-100" %>
            <%= link_to "いいえ", game_path(panel: "blacksmith", blacksmith_menu: "repair", smith_mode: smith_mode), class: "btn btn-outline-light flex-fill" %>
          </div>
        </div>
      <% else %>
        <%= link_to "すべて整備する / #{bulk_repair_cost}コル", game_path(panel: "blacksmith", blacksmith_menu: "repair", smith_mode: smith_mode, confirm_repair_all: "1"), class: "btn btn-warning w-100 mb-3" %>
      <% end %>
    <% end %>

    <h6>武器整備</h6>
    <% if context&.player? %>
      <% kit = @player.items.find_by(name: WeaponMaintenanceService::KIT_NAME) %>
      <p class="small">武器整備キット: <%= kit ? "#{kit.effective_durability} / #{kit.effective_max_durability}（#{kit.quantity}個）" : "未所持" %>／今回の消耗 <%= WeaponMaintenanceService.kit_cost_for(context.proficiency) %></p>
    <% end %>
    <% if damaged_weapons.any? && context %>
      <div class="d-grid gap-2">
        <% damaged_weapons.each do |weapon| %>
          <% available = context.proficiency >= weapon.maintenance_level.to_i %>
          <div class="border rounded p-2">
            <p class="mb-1"><strong><%= weapon.display_name %></strong>／耐久 <%= weapon.durability %> / <%= weapon.effective_max_durability %></p>
            <p class="mb-2">必要熟練度 <%= weapon.maintenance_level %>／<%= context.player? ? "工賃0コル" : "整備費#{(weapon.repair_cost * context.fee_multiplier(:maintenance)).round}コル" %></p>
            <%= button_to available ? "最大まで整備" : "鍛冶熟練度不足", blacksmith_path(weapon_id: weapon.id, smith_mode: smith_mode), method: :post, disabled: !available, class: "btn btn-outline-warning btn-sm w-100" %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="mb-0">整備できる武器がありません。</p>
    <% end %>

    <% if smith_mode == "npc" %>
      <h6 class="mt-3">防具整備</h6>
      <% if damaged_armors.any? %>
        <div class="d-grid gap-2">
          <% damaged_armors.each do |armor| %>
            <div class="border rounded p-2">
              <p class="mb-1"><strong><%= armor.name %></strong>（<%= armor.slot_name %>）／耐久 <%= armor.durability %> / <%= armor.max_durability %></p>
              <p class="mb-2">整備費 <%= armor.repair_cost %>コル</p>
              <%= button_to "最大まで整備", blacksmith_path(armor_id: armor.id, smith_mode: smith_mode), method: :post, class: "btn btn-outline-warning btn-sm w-100" %>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="mb-0">整備できる防具がありません。</p>
      <% end %>
    <% end %>

  <% elsif blacksmith_menu == "upgrade" %>
    <% selected_weapon = @player.weapons.find_by(id: params[:weapon_id]) %>
    <% if selected_weapon && context %>
      <%= link_to "強化する武器一覧に戻る", game_path(panel: "blacksmith", blacksmith_menu: "upgrade", smith_mode: smith_mode), class: "btn btn-outline-light w-100 mb-3" %>
      <h6><%= selected_weapon.display_name %></h6>
      <p class="small mb-2"><%= selected_weapon.enhancement_breakdown %>／強化試行 <%= selected_weapon.enhance_attempts %> / <%= selected_weapon.enhance_limit %></p>
      <% if selected_weapon.max_enhancement? %>
        <p class="mb-0"><%= WeaponUpgradeService.enhancement_limit_message(selected_weapon) %></p>
      <% else %>
        <div class="d-grid gap-2">
          <% Weapon::ENHANCEMENT_TYPES.each do |type, config| %>
            <% quote = WeaponUpgradeService.quote_for(selected_weapon, type, player: @player, blacksmith: npc_blacksmith, context: context) %>
            <% next unless quote %>
            <% available = context.proficiency >= quote.processing_level %>
            <% effect_previews = WeaponUpgradeService.effect_previews_for(selected_weapon, type) %>
            <% confirming = params[:confirm_upgrade_type].to_s.upcase == type %>
            <% if confirming %>
              <div class="border border-warning rounded p-2">
                <p class="mb-1"><strong><%= config[:name] %>を強化</strong>／成功率 <%= quote.success_rate %>%</p>
                <p class="small text-muted mb-1"><%= config[:effect] %></p>
                <div class="border rounded p-2 mb-2">
                  <p class="small mb-1"><strong>成功時の変化</strong></p>
                  <% effect_previews.each do |preview| %>
                    <p class="small mb-1">
                      <%= preview.label %>:
                      <%= formatted_enhancement_preview_value(preview, preview.before_value) %><%= preview.unit %>
                      →
                      <%= formatted_enhancement_preview_value(preview, preview.after_value) %><%= preview.unit %>
                      （<%= formatted_enhancement_preview_change(preview) %>）
                    </p>
                  <% end %>
                </div>
                <p class="mb-1">必要熟練度 <%= quote.processing_level %>／鍛冶補正 +<%= quote.blacksmith_bonus %>pt</p>
                <p class="mb-2">必要: <%= quote.required_col %>コル／<%= quote.required_materials.map { |name, count| "#{name} ×#{count}" }.join("、") %></p>
                <% if available %>
                <div class="border border-warning rounded p-2">
                  <p class="mb-1"><strong><%= config[:name] %>を強化しますか？</strong></p>
                  <p class="small mb-2">成功率 <%= quote.success_rate %>%。失敗時もコル・素材・強化試行回数を消費します。</p>
                  <div class="d-flex gap-2">
                    <%= button_to "はい", upgrade_weapon_path(weapon_id: selected_weapon.id, enhancement_type: type, smith_mode: smith_mode, confirm_upgrade: "1"), method: :post, form: { class: "flex-fill" }, class: "btn btn-warning w-100" %>
                    <%= link_to "いいえ", game_path(panel: "blacksmith", blacksmith_menu: "upgrade", weapon_id: selected_weapon.id, smith_mode: smith_mode), class: "btn btn-outline-light flex-fill" %>
                  </div>
                </div>
                <% else %>
                  <button type="button" class="btn btn-outline-secondary btn-sm w-100" disabled>素材の加工熟練度不足</button>
                <% end %>
              </div>
            <% elsif available %>
              <%= link_to "#{config[:name]}を強化", game_path(panel: "blacksmith", blacksmith_menu: "upgrade", weapon_id: selected_weapon.id, smith_mode: smith_mode, confirm_upgrade_type: type), class: "btn btn-outline-warning btn-sm w-100" %>
            <% else %>
              <button type="button" class="btn btn-outline-secondary btn-sm w-100" disabled><%= config[:name] %>（加工熟練度不足）</button>
              <% end %>
          <% end %>
        </div>
      <% end %>
    <% elsif @player.weapons.any? %>
      <div class="d-grid gap-2">
        <% @player.weapons.each do |weapon| %>
          <%= link_to "#{weapon.display_name}／強化試行 #{weapon.enhance_attempts}/#{weapon.enhance_limit}", game_path(panel: "blacksmith", blacksmith_menu: "upgrade", weapon_id: weapon.id, smith_mode: smith_mode), class: "btn btn-outline-warning w-100" %>
        <% end %>
      </div>
    <% else %>
      <p class="mb-0">強化できる武器がありません。</p>
    <% end %>

  <% elsif blacksmith_menu == "evolve" %>
    <% selected_weapon = @player.weapons.find_by(id: params[:weapon_id]) %>
    <% rule = WeaponEvolutionRule.find_by(source_weapon_name: selected_weapon&.name) %>
    <% if selected_weapon && rule %>
      <h6><%= selected_weapon.display_name %></h6>
      <p>進化先: <%= rule.target_weapon_name %>／必要強化値 +<%= rule.required_enhancement_level %>／必要Lv <%= rule.required_player_level %></p>
      <%= button_to "進化する", evolve_weapon_path(weapon_id: selected_weapon.id), method: :post, class: "btn btn-outline-warning w-100" %>
    <% else %>
      <div class="d-grid gap-2">
        <% @player.weapons.each do |weapon| %>
          <% next unless WeaponEvolutionRule.exists?(source_weapon_name: weapon.name) %>
          <%= link_to weapon.display_name, game_path(panel: "blacksmith", blacksmith_menu: "evolve", weapon_id: weapon.id), class: "btn btn-outline-warning w-100" %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <p class="mb-0">左のメニューから行動を選択してください。</p>
  <% end %>
</div>
