<% blacksmith_menu = params[:blacksmith_menu].presence %>
<% player_blacksmith_skill = BlacksmithService.blacksmith_skill_for(@player) %>
<% self_mode_selectable = player_blacksmith_skill.present? && blacksmith_menu != "repair" %>
<% smith_mode = self_mode_selectable && params[:smith_mode] == "player" ? "player" : "npc" %>
<% npc_blacksmith = BlacksmithService.current_for(@player) %>
<% context = BlacksmithService.context_for(@player, mode: smith_mode, blacksmith: npc_blacksmith) %>
<div class="card-header">鍛冶屋</div>
<div class="card-body">
  <div class="border rounded p-2 mb-3">
    <p class="mb-1"><strong>鍛冶師: <%= context&.name || "選択できません" %></strong></p>
    <p class="mb-2"><%= BlacksmithService.skill_label(context) %></p>
    <% if self_mode_selectable %>
      <p class="small text-muted mb-1">鍛冶を行う者を選択</p>
      <div class="d-flex gap-2">
        <% if npc_blacksmith %>
          <%= link_to npc_blacksmith.name, game_path(panel: "blacksmith", blacksmith_menu: blacksmith_menu, smith_mode: "npc"), class: "btn btn-sm #{smith_mode == 'npc' ? 'btn-warning' : 'btn-outline-warning'} flex-fill" %>
        <% end %>
        <%= link_to "自分", game_path(panel: "blacksmith", blacksmith_menu: blacksmith_menu, smith_mode: "player"), class: "btn btn-sm #{smith_mode == 'player' ? 'btn-warning' : 'btn-outline-warning'} flex-fill" %>
      </div>
    <% end %>
  </div>

  <% if blacksmith_menu == "produce" %>
    <h6>武器生産</h6>
    <% if params[:weapon_name].present? %>
      <p class="mb-1">現所持数: <%= owned_weapon_count(@player, params[:weapon_name]) %>本</p>
    <% end %>
    <p class="small text-muted">武器種と3枠の素材から性能を生成します。完成性能と武器名は鍛造まで確定しません。</p>
    <% if context %>
      <p class="small mb-2">現在の鍛冶熟練度: <%= context.proficiency %>（<%= BlacksmithService.tier_name_for(context.proficiency) %>帯）</p>
      <%= form_with url: game_path, method: :get, local: true do |form| %>
        <%= form.hidden_field :panel, value: "blacksmith" %>
        <%= form.hidden_field :blacksmith_menu, value: "produce" %>
        <%= form.hidden_field :smith_mode, value: smith_mode %>
        <% selected_template = WeaponCraftTypeCatalog.find(params[:weapon_type]) %>
        <div class="mb-2">
          <%= form.label :weapon_type, "武器種", class: "form-label" %>
          <%= form.select :weapon_type, options_for_select(WeaponCraftTypeCatalog.all.map { |entry| [entry.weapon_type, entry.weapon_type] }, params[:weapon_type]), {}, class: "form-select" %>
        </div>
        <% if selected_template %>
          <p class="small text-muted mb-2">
            属性<%= selected_template.attack_attributes %>／攻撃倍率<%= selected_template.attack_multiplier %>／耐久倍率<%= selected_template.durability_multiplier %>／重量倍率<%= selected_template.weight_multiplier %>／強化上限倍率<%= selected_template.enhance_multiplier %><br>
            必要素材数: 鉱石×<%= selected_template.ore_quantity %>／モンスター素材×<%= selected_template.monster_quantity %>／補助素材×<%= selected_template.support_quantity %>
          </p>
        <% end %>
        <% [["ore_material", "鉱石素材", "ore"], ["monster_material", "モンスター素材", "monster_material"], ["support_material", "補助素材", "support_material"]].each do |field, label, category| %>
          <div class="mb-2">
            <%= form.label field, label, class: "form-label" %>
            <% materials = BlacksmithMaterialCatalog.for_category(category).select { |material| material.processing_level <= context.proficiency } %>
            <% if materials.any? %>
              <%= form.select field,
                options_for_select(
                  materials.map { |material| ["#{material.name}（所持#{@player.items.where(name: material.name).sum(:quantity)}／#{material.effect_summary}）", material.name] },
                  params[field]
                ), {}, class: "form-select" %>
            <% else %>
              <p class="text-warning small mb-0">現在の熟練度では扱える<%= label %>がありません。</p>
            <% end %>
          </div>
        <% end %>
        <%= form.submit "この内容でプレビュー", class: "btn btn-outline-warning w-100" %>
      <% end %>

      <% if params[:weapon_type].present? && params[:ore_material].present? && params[:monster_material].present? && params[:support_material].present? %>
        <% preview = WeaponCraftService.preview_for(context: context, weapon_type: params[:weapon_type], ore_material: params[:ore_material], monster_material: params[:monster_material], support_material: params[:support_material]) %>
        <% if preview.status == :error %>
          <p class="text-warning mt-2 mb-0"><%= preview.message %></p>
        <% else %>
          <div class="border border-warning rounded p-2 mt-3">
            <p class="mb-1"><strong>鍛造プレビュー</strong>／必要熟練度<%= preview.required_level %>／推定レアリティ<%= preview.rarity %></p>
            <p class="small mb-1">
              攻撃力 <%= preview.attack_range.first %>〜<%= preview.attack_range.last %>／
              耐久値 <%= preview.durability_range.first %>〜<%= preview.durability_range.last %>／
              重量 <%= preview.weight_range.first %>〜<%= preview.weight_range.last %>／
              強化試行上限 <%= preview.enhance_limit_range.first %>〜<%= preview.enhance_limit_range.last %>
            </p>
            <p class="small mb-2">工賃: <%= context.player? ? "工賃なし" : "#{preview.fee}刻銭" %>／必要素材: <%= preview.quantities.map { |name, count| "#{name} ×#{count}" }.join("、") %></p>
            <% if preview.available %>
              <% missing = preview.quantities.find { |name, count| @player.items.where(name: name).sum(:quantity).to_i < count } %>
              <% if missing %>
                <button type="button" class="btn btn-outline-secondary btn-sm w-100" disabled>素材が不足しています（<%= missing.first %> ×<%= missing.last %>必要）</button>
              <% else %>
                <%= button_to "この内容で鍛造する", produce_weapon_path(
                  smith_mode: smith_mode, confirm_produce: "1", weapon_type: params[:weapon_type],
                  ore_material: params[:ore_material], monster_material: params[:monster_material], support_material: params[:support_material]
                ), method: :post, class: "btn btn-warning w-100" %>
              <% end %>
            <% else %>
              <button type="button" class="btn btn-outline-secondary btn-sm w-100" disabled>素材の加工熟練度不足</button>
            <% end %>
          </div>
        <% end %>
      <% end %>
    <% else %>
      <p class="text-warning mb-0">現在利用できる鍛冶師がいません。</p>
    <% end %>

  <% elsif blacksmith_menu == "repair" %>
    <% damaged_weapons = @player.weapons.select { |weapon| weapon.durability.to_i < weapon.effective_max_durability } %>
    <% damaged_armors = @player.armors.select { |armor| armor.repair_cost.positive? } %>
    <% maintenance_fee_multiplier = context&.fee_multiplier(:maintenance) || 1 %>
    <% bulk_weapons = smith_mode == "npc" && context ? damaged_weapons.select { |weapon| context.proficiency >= weapon.maintenance_level.to_i } : [] %>
    <% bulk_equipment_count = bulk_weapons.size + damaged_armors.size %>
    <% bulk_repair_cost = bulk_weapons.sum { |weapon| (weapon.repair_cost * maintenance_fee_multiplier).round } + damaged_armors.sum { |armor| (armor.repair_cost * maintenance_fee_multiplier).round } %>
    <% if smith_mode == "npc" && bulk_equipment_count.positive? %>
      <% if params[:confirm_repair_all] == "1" %>
        <div class="border border-warning rounded p-2 mb-3">
          <h6>すべて整備しますか？</h6>
          <p class="mb-1">対象: <%= bulk_equipment_count %>点</p>
          <p class="mb-2">費用: <%= bulk_repair_cost %>刻銭</p>
          <div class="d-flex gap-2">
            <%= button_to "はい", blacksmith_path(repair_all: "1", confirm_repair: "1", smith_mode: smith_mode), method: :post, form: { class: "flex-fill" }, class: "btn btn-warning w-100" %>
            <%= link_to "いいえ", game_path(panel: "blacksmith", blacksmith_menu: "repair", smith_mode: smith_mode), class: "btn btn-outline-light flex-fill" %>
          </div>
        </div>
      <% else %>
        <%= link_to "すべて整備する / #{bulk_repair_cost}刻銭", game_path(panel: "blacksmith", blacksmith_menu: "repair", smith_mode: smith_mode, confirm_repair_all: "1"), class: "btn btn-warning w-100 mb-3" %>
      <% end %>
    <% end %>

    <h6>武器整備</h6>
    <p class="small text-muted">自分の武器を無料で直したい場合は、装備画面から携帯用の「武器整備キット」を使ってください。</p>
    <% if damaged_weapons.any? && context %>
      <div class="d-grid gap-2">
        <% damaged_weapons.each do |weapon| %>
          <% available = context.proficiency >= weapon.maintenance_level.to_i %>
          <div class="border rounded p-2">
            <p class="mb-1"><strong><%= weapon.display_name %></strong>／耐久 <%= weapon.durability %> / <%= weapon.effective_max_durability %></p>
            <p class="mb-2">必要熟練度 <%= weapon.maintenance_level %>／<%= context.player? ? "工賃0刻銭" : "整備費#{(weapon.repair_cost * context.fee_multiplier(:maintenance)).round}刻銭" %></p>
            <%= button_to available ? "最大まで整備" : "鍛冶熟練度不足", blacksmith_path(weapon_id: weapon.id, smith_mode: smith_mode), method: :post, disabled: !available, class: "btn btn-outline-warning btn-sm w-100" %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="mb-0">整備できる武器がありません。</p>
    <% end %>

    <% if smith_mode == "npc" %>
      <h6 class="mt-3">防具整備</h6>
      <% if damaged_armors.any? %>
        <div class="d-grid gap-2">
          <% damaged_armors.each do |armor| %>
            <div class="border rounded p-2">
              <p class="mb-1"><strong><%= armor.name %></strong>（<%= armor.slot_name %>）／耐久 <%= armor.durability %> / <%= armor.max_durability %></p>
              <p class="mb-2">整備費 <%= armor.repair_cost %>刻銭</p>
              <%= button_to "最大まで整備", blacksmith_path(armor_id: armor.id, smith_mode: smith_mode), method: :post, class: "btn btn-outline-warning btn-sm w-100" %>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="mb-0">整備できる防具がありません。</p>
      <% end %>
    <% end %>

  <% elsif blacksmith_menu == "upgrade" %>
    <% selected_weapon = @player.weapons.find_by(id: params[:weapon_id]) %>
    <% if selected_weapon && context %>
      <%= link_to "強化する武器一覧に戻る", game_path(panel: "blacksmith", blacksmith_menu: "upgrade", smith_mode: smith_mode), class: "btn btn-outline-light w-100 mb-3" %>
      <h6><%= selected_weapon.display_name %></h6>
      <p class="small mb-2"><%= selected_weapon.enhancement_breakdown %>／強化試行 <%= selected_weapon.enhance_attempts %> / <%= selected_weapon.enhance_limit %></p>
      <% if selected_weapon.max_enhancement? %>
        <p class="mb-0"><%= WeaponUpgradeService.enhancement_limit_message(selected_weapon) %></p>
      <% else %>
        <div class="d-grid gap-2">
          <% Weapon::ENHANCEMENT_TYPES.each do |type, config| %>
            <% quote = WeaponUpgradeService.quote_for(selected_weapon, type, player: @player, blacksmith: npc_blacksmith, context: context, material_quantities: params[:enhancement_materials]&.to_unsafe_h) %>
            <% next unless quote %>
            <% available = context.proficiency >= quote.processing_level %>
            <% effect_previews = WeaponUpgradeService.effect_previews_for(selected_weapon, type) %>
            <% confirming = params[:confirm_upgrade_type].to_s.upcase == type %>
            <% if confirming %>
              <div class="border border-warning rounded p-2">
                <p class="mb-1"><strong><%= config[:name] %>を強化</strong>／成功率 <%= quote.success_rate %>%</p>
                <p class="small text-muted mb-1"><%= config[:effect] %></p>
                <div class="border rounded p-2 mb-2">
                  <p class="small mb-1"><strong>成功時の変化</strong></p>
                  <% effect_previews.each do |preview| %>
                    <p class="small mb-1">
                      <%= preview.label %>:
                      <%= formatted_enhancement_preview_value(preview, preview.before_value) %><%= preview.unit %>
                      →
                      <%= formatted_enhancement_preview_value(preview, preview.after_value) %><%= preview.unit %>
                      （<%= formatted_enhancement_preview_change(preview) %>）
                    </p>
                  <% end %>
                </div>
                <% material_options = WeaponUpgradeService.material_options_for(@player, type, WeaponEnhancementCatalog.step_for(quote.target_level).material_rank, proficiency: context.proficiency) %>
                <%= form_with url: game_path, method: :get, local: true, class: "border rounded p-2 mb-2", data: { controller: "material-allocation", material_allocation_guaranteed_points_value: quote.guaranteed_points } do %>
                  <%= hidden_field_tag :panel, "blacksmith" %>
                  <%= hidden_field_tag :blacksmith_menu, "upgrade" %>
                  <%= hidden_field_tag :weapon_id, selected_weapon.id %>
                  <%= hidden_field_tag :smith_mode, smith_mode %>
                  <%= hidden_field_tag :confirm_upgrade_type, type %>
                  <p class="small mb-1"><strong>素材配合</strong></p>
                  <p class="small mb-1">最低必要ポイント: <%= quote.required_points %>pt（熟練度による軽減なし）</p>
                  <p class="small mb-1">100%基準: <%= quote.base_guaranteed_points %>pt − 鍛冶熟練度軽減 <%= quote.guaranteed_point_reduction %>pt ＝ <%= quote.guaranteed_points %>pt（10刻み・<%= (quote.proficiency_reduction_rate * 100).round(1) %>%軽減）</p>
                  <% if material_options.any? %>
                    <% material_options.each do |material, owned| %>
                      <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="small flex-grow-1"><%= material.name %>（<%= material.enhancement_points %>pt／所持<%= owned %>）</span>
                        <%= number_field_tag "enhancement_materials[#{material.name}]", quote.required_materials.fetch(material.name, 0), min: 0, max: owned, class: "form-control form-control-sm", style: "width: 6rem", data: { material_allocation_target: "input", material_points: material.enhancement_points } %>
                      </div>
                    <% end %>
                    <div class="d-flex gap-2 mb-2">
                      <button type="button" class="btn btn-outline-light btn-sm flex-fill" data-action="material-allocation#fillLowFirst">100%まで投入（低pt優先）</button>
                      <button type="button" class="btn btn-outline-light btn-sm flex-fill" data-action="material-allocation#fillHighFirst">100%まで投入（高pt優先）</button>
                    </div>
                  <% else %>
                    <p class="small text-warning">現在の熟練度で加工できる所持素材がありません。</p>
                  <% end %>
                  <p class="small mb-1">投入 <%= quote.invested_points %>pt／必要 <%= quote.required_points %>pt<%= "（あと#{quote.point_shortage}pt）" unless quote.points_satisfied? %></p>
                  <p class="small mb-2">現在の成功率: <strong><%= quote.success_rate %>%</strong>（<%= quote.guaranteed_points %>ptで100%）</p>
                  <%= submit_tag "配合を再計算", class: "btn btn-outline-warning btn-sm w-100" %>
                <% end %>
                <p class="mb-1">必要熟練度 <%= quote.processing_level %>／鍛冶補正 +<%= quote.blacksmith_bonus %>pt</p>
                <p class="mb-1">基本条件: <%= quote.required_col %>刻銭／強化ポイント <%= quote.required_points %>pt</p>
                <p class="mb-2">今回の配合素材: <%= quote.required_materials.map { |name, count| "#{name} ×#{count}" }.join("、") %>（投入 <%= quote.invested_points %>pt）</p>
                <% if available && quote.points_satisfied? %>
                <div class="border border-warning rounded p-2">
                  <p class="mb-1"><strong><%= config[:name] %>を強化しますか？</strong></p>
                  <p class="small mb-2">成功率 <%= quote.success_rate %>%。失敗時も刻銭・素材・強化試行回数を消費します。</p>
                  <div class="d-flex gap-2">
                    <%= button_to "はい", upgrade_weapon_path(weapon_id: selected_weapon.id, enhancement_type: type, smith_mode: smith_mode, enhancement_materials: quote.required_materials, confirm_upgrade: "1"), method: :post, form: { class: "flex-fill" }, class: "btn btn-warning w-100" %>
                    <%= link_to "いいえ", game_path(panel: "blacksmith", blacksmith_menu: "upgrade", weapon_id: selected_weapon.id, smith_mode: smith_mode), class: "btn btn-outline-light flex-fill" %>
                  </div>
                </div>
                <% elsif !quote.points_satisfied? %>
                  <button type="button" class="btn btn-outline-secondary btn-sm w-100" disabled>強化ポイント不足</button>
                <% else %>
                  <button type="button" class="btn btn-outline-secondary btn-sm w-100" disabled>素材の加工熟練度不足</button>
                <% end %>
              </div>
            <% elsif available %>
              <%= link_to "#{config[:name]}を強化", game_path(panel: "blacksmith", blacksmith_menu: "upgrade", weapon_id: selected_weapon.id, smith_mode: smith_mode, confirm_upgrade_type: type), class: "btn btn-outline-warning btn-sm w-100" %>
            <% else %>
              <button type="button" class="btn btn-outline-secondary btn-sm w-100" disabled><%= config[:name] %>（加工熟練度不足）</button>
              <% end %>
          <% end %>
        </div>
      <% end %>
    <% elsif @player.weapons.any? %>
      <div class="d-grid gap-2">
        <% @player.weapons.each do |weapon| %>
          <%= link_to "#{weapon.display_name}／強化試行 #{weapon.enhance_attempts}/#{weapon.enhance_limit}", game_path(panel: "blacksmith", blacksmith_menu: "upgrade", weapon_id: weapon.id, smith_mode: smith_mode), class: "btn btn-outline-warning w-100" %>
        <% end %>
      </div>
    <% else %>
      <p class="mb-0">強化できる武器がありません。</p>
    <% end %>

  <% elsif blacksmith_menu == "evolve" %>
    <% selected_weapon = @player.weapons.find_by(id: params[:weapon_id]) %>
    <% quote = selected_weapon && WeaponEvolutionService.quote_for(@player, selected_weapon, blacksmith_mode: smith_mode, blacksmith: npc_blacksmith) %>
    <% if selected_weapon && quote %>
      <h6><%= selected_weapon.display_name %></h6>
      <p class="mb-1">進化先: <%= quote.rule.target_weapon_name %></p>
      <p class="mb-1 small">達成条件:</p>
      <ul class="small">
        <% quote.condition_summaries.each do |summary| %>
          <li><%= summary %></li>
        <% end %>
      </ul>
      <p class="small mb-1">必要鍛冶熟練度: <%= quote.required_smith_proficiency %>（現在<%= quote.smith_proficiency %>）</p>
      <p class="small mb-1">必要刻銭: <%= quote.required_col %>刻銭</p>
      <% if quote.required_items.any? %>
        <p class="small mb-1">必要素材: <%= quote.required_items.map { |name, qty| "#{name}×#{qty}" }.join("／") %></p>
      <% end %>
      <% unless quote.executable? %>
        <p class="text-warning small mb-2">まだ進化させられません（条件・熟練度・素材/刻銭のいずれかが不足しています）。</p>
      <% end %>
      <%= button_to "進化する", evolve_weapon_path(weapon_id: selected_weapon.id, smith_mode: smith_mode, confirm_evolve: 1), method: :post, class: "btn btn-outline-warning w-100", disabled: !quote.executable? %>
    <% else %>
      <div class="d-grid gap-2">
        <% @player.weapons.each do |weapon| %>
          <% next unless WeaponEvolutionService.eligible_rule_for(weapon) %>
          <%= link_to weapon.display_name, game_path(panel: "blacksmith", blacksmith_menu: "evolve", weapon_id: weapon.id, smith_mode: smith_mode), class: "btn btn-outline-warning w-100" %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <p class="mb-0">左のメニューから行動を選択してください。</p>
  <% end %>
</div>
